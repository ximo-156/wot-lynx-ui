{
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.ttf"
  ],
  "scripts": {
    "gen:index": "node ../../scripts/gen-index.mjs",
    "build:css": "node ../../scripts/build-css.mjs",
    "build": "node ../../scripts/build-css.mjs && node ../../scripts/build-dist.mjs"
  },
  "keywords": [
    "vue",
    "lynx",
    "vue-lynx",
    "wot-ui",
    "components"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-lynx": "^0.5.0"
  },
  "dependencies": {
    "@wot-lynx/core": "workspace:*",
    "@wot-lynx/primitives": "workspace:*",
    "@wot-lynx/ui-display": "workspace:*",
    "@wot-lynx/ui-layout": "workspace:*"
  },
  "name": "@wot-lynx/ui-form",
  "description": "wot-lynx-ui 表单域：form、rate、slider、upload、address-edit、cascader、select-picker 等",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "types": "./src/index.ts"
    },
    "./*": {
      "source": "./src/*/index.ts",
      "import": "./dist/*/index.mjs",
      "types": "./src/*/index.ts"
    },
    "./*/types": {
      "source": "./src/*/types.ts",
      "types": "./src/*/types.ts"
    },
    "./package.json": "./package.json"
  }
}
