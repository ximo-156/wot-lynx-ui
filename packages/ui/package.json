{
  "name": "wot-lynx-ui",
  "version": "0.1.0",
  "description": "基于 Vue Lynx 的 wot-ui 适配组件库 — 原生性能、样式与 wot-ui 一致",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./theme": {
      "source": "./src/styles/theme/index.scss",
      "import": "./dist/theme/index.css"
    },
    "./theme/presets": {
      "source": "./src/styles/theme/presets/index.scss",
      "import": "./dist/theme/presets/index.css"
    },
    "./theme/presets/*": {
      "source": "./src/styles/theme/presets/*.scss",
      "import": "./dist/theme/presets/*.css"
    },
    "./components/*": {
      "source": "./src/components/*/*.vue",
      "import": "./dist/components/*/index.mjs"
    },
    "./primitives/*": {
      "source": "./src/primitives/*/*.vue",
      "import": "./dist/primitives/*/index.mjs"
    },
    "./package.json": "./package.json",
    "./plugin": "./plugin/index.js"
  },
  "files": [
    "src",
    "dist",
    "plugin",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.ttf"
  ],
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:css": "node ../../scripts/build-css.mjs",
    "build": "node ../../scripts/build-css.mjs && node ../../scripts/build-dist.mjs",
    "gen:index": "node ../../scripts/gen-index.mjs"
  },
  "keywords": [
    "vue",
    "lynx",
    "vue-lynx",
    "wot-ui",
    "components",
    "ui",
    "cross-platform"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-lynx": "^0.5.0"
  },
  "devDependencies": {
    "@lynx-js/testing-environment": "^0.1.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/runtime-core": "^3.5.0",
    "jsdom": "^25.0.0",
    "postcss": "8.5.30",
    "sass": "^1.105.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.30",
    "vue-lynx": "^0.5.1",
    "vue-tsc": "^2.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wot-lynx-ui/wot-lynx-ui.git"
  },
  "homepage": "https://wot-lynx-ui.github.io",
  "dependencies": {
    "dayjs": "^1.11.23"
  }
}
