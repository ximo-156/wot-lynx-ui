{
  "name": "@wot-lynx/primitives",
  "version": "0.1.0",
  "description": "wot-lynx-ui L3.5 基础件：高 fan-in 叶子件与跨域复用 building block",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./wd-*": {
      "source": "./src/wd-*/index.ts",
      "import": "./dist/wd-*/index.mjs",
      "types": "./src/wd-*/index.ts"
    },
    "./wd-*/types": {
      "source": "./src/wd-*/types.ts",
      "types": "./src/wd-*/types.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.ttf"
  ],
  "scripts": {
    "gen:index": "node ../../scripts/gen-index.mjs",
    "build:css": "node ../../scripts/build-css.mjs",
    "build": "node ../../scripts/build-css.mjs && node ../../scripts/build-dist.mjs"
  },
  "keywords": [
    "vue",
    "lynx",
    "vue-lynx",
    "wot-ui",
    "components",
    "primitives"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-lynx": "^0.5.0"
  },
  "dependencies": {
    "@wot-lynx/core": "workspace:*"
  }
}
