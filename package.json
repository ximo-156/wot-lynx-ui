{
  "name": "wot-lynx-ui-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter wot-lynx-demo run dev",
    "dev:device-test": "pnpm --filter wot-lynx-demo run dev:device-test",
    "build:demo": "pnpm --filter wot-lynx-demo run build",
    "build:device-test": "pnpm --filter wot-lynx-demo run build:device-test",
    "build:css": "pnpm --filter wot-lynx-ui run build:css",
    "build:ui": "pnpm --filter wot-lynx-ui run build",
    "gen:index": "node scripts/gen-index.mjs",
    "gen:component": "node scripts/gen-component.mjs",
    "gen:meta": "node scripts/gen-meta.mjs",
    "gen:docs": "node scripts/gen-docs.mjs",
    "api:diff": "node scripts/api-diff.mjs",
    "codemod": "node scripts/codemod.mjs",
    "visual:baseline": "node scripts/visual-regression.mjs --update",
    "visual:check": "node scripts/visual-regression.mjs --check",
    "check:index": "node scripts/gen-index.mjs --check",
    "check:deps": "node scripts/analyze-deps.mjs --check",
    "check:snapshot": "node scripts/gen-snapshot.mjs --check",
    "check:meta": "node scripts/gen-meta.mjs --check",
    "check:docs": "node scripts/gen-docs.mjs --check",
    "check:exports": "node scripts/check-exports.mjs",
    "lint:conventions": "node scripts/review-lint.mjs",
    "audit:design": "node scripts/design-audit.mjs",
    "audit:design:json": "node scripts/design-audit.mjs --json",
    "typecheck": "pnpm --filter wot-lynx-ui run typecheck",
    "test": "pnpm --filter wot-lynx-ui run test",
    "test:shard": "node scripts/test-shard.mjs",
    "test:shard:plan": "node scripts/test-shard.mjs --plan",
    "test:shard:update": "node scripts/test-shard.mjs --update",
    "docs:dev": "pnpm --filter wot-lynx-ui-docs run dev",
    "docs:build": "pnpm --filter wot-lynx-ui-docs run build",
    "verify": "pnpm check:index && pnpm check:exports && pnpm check:deps && pnpm check:snapshot && pnpm check:meta && pnpm check:docs && pnpm build:css && pnpm typecheck && pnpm test && pnpm build:demo"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "vue-lynx": "0.5.1",
      "vue": "3.5.43",
      "@vue/runtime-core": "3.5.43",
      "postcss": "8.5.30",
      "webpack": "5.111.1"
    }
  }
}
