<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.wotlynx.mediapicker">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Album selection uses user-granted content URIs, not storage permissions. -->
    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.provider.action.PICK_IMAGES" /></intent>
        <intent><action android:name="android.intent.action.OPEN_DOCUMENT" /><data android:mimeType="*/*" /></intent>
    </queries>
    <application>
        <activity
            android:name="com.wotlynx.mediapicker.WotMediaPickerActivity"
            android:exported="false"
            android:theme="@style/WotMediaPickerProxyTheme" />
        <provider
            android:name="com.wotlynx.mediapicker.WotMediaPickerFileProvider"
            android:authorities="${applicationId}.wot.media.picker.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/wot_media_picker_paths" />
        </provider>
    </application>
</manifest>
